#include <cstdint>
#include <cstdio>
@MODEL@
int main(){
 Model m;m.rst_n=0;m.ena=1;m.tick();m.rst_n=1;
 uint64_t cases=0,clocks=0;
 for(unsigned op=0;op<4;++op)for(unsigned a=0;a<256;++a)for(unsigned b=0;b<256;++b){
  m.ui_in=a;m.uio_in=1;m.tick();m.ui_in=b;m.uio_in=2;m.tick();
  m.uio_in=4|(op<<3);m.tick();m.uio_in=op<<3;
  int latency=0;while(m.busy()&&latency<258){m.tick();++latency;++clocks;}
  if(m.busy()){std::printf("timeout %u %u %u\n",op,a,b);return 1;}
  unsigned got=m.result();
  unsigned expected=op==0?a+b:op==1?((a-b)&65535):op==2?a*b:b?a/b:65535;
  if(got!=expected||m.divzero()!=(op==3&&b==0)){
   std::printf("FAIL op=%u A=%u B=%u got=%u expected=%u\n",op,a,b,got,expected);return 1;}
  ++cases;
 }
 m.ui_in=255;m.uio_in=1;m.tick();m.ui_in=255;m.uio_in=2;m.tick();
 m.uio_in=4|(2<<3);m.tick();m.uio_in=0;
 unsigned before=m.result();m.ena=0;for(int i=0;i<5;++i)m.tick();
 if(!m.busy()||m.result()!=before)return 2;
 m.rst_n=0;m.tick();m.rst_n=1;m.ena=1;
 if(m.busy()||m.divzero()||m.result()!=0)return 3;
 std::printf("PASS: %llu exhaustive arithmetic cases, %llu busy cycles; pause/reset passed\n",
 (unsigned long long)cases,(unsigned long long)clocks);
}
